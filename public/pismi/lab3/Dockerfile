# Образ для лабораторної роботи № 3.
#
# На відміну від робіт № 1 і № 2, тут потрібен власний образ: розширення для
# MySQL мають бути в самому образі, а не доставлятися командою під час
# кожного запуску контейнера. Так контейнер піднімається за секунди й не
# залежить від того, чи доступні репозиторії пакетів.
FROM php:8.2-apache

# Розширення PHP для роботи з MySQL
RUN docker-php-ext-install pdo pdo_mysql mysqli

# Увімкнення mod_rewrite
RUN a2enmod rewrite

# Встановлення робочої директорії
WORKDIR /var/www/html

# Налаштування прав доступу
RUN chown -R www-data:www-data /var/www/html
